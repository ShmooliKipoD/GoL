<Project Sdk="Microsoft.NET.Sdk">

  <!-- HEADLESS SIMULATION CORE.
       The rule is "never NEEDS graphics to run", not "never references MonoGame":
       this project uses MonoGame.Extended's ECS, which was verified to build and
       run with no GraphicsDevice, no window and no DYLD_FALLBACK_LIBRARY_PATH.
       tools/GoL.Headless is the standing proof - it references only this project
       and is run without that variable.
       Use System.Numerics.Vector2 here; GoL.Render converts at the boundary. -->
  <PropertyGroup>
    <RootNamespace>GoL.Sim</RootNamespace>

    <!-- Explicit usings ONLY. The solution-wide default would put System.Linq in
         scope in every file, and LINQ allocates - this assembly runs a tick loop
         at 60Hz over hundreds of creatures and must not allocate inside it.
         Turning it off makes `using System.Linq;` a visible, reviewable line
         rather than an invisible default. -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- ECS only. Nothing here may touch GraphicsDevice, SpriteBatch or Game. -->
    <PackageReference Include="MonoGame.Extended" Version="4.0.0" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
  </ItemGroup>

</Project>
