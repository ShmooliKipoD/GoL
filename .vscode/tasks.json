{
  "version": "2.0.0",

  // "command" is an ABSOLUTE path, and every task puts dotnet's directory on PATH.
  // Both are needed, for two different reasons:
  //
  //  1. "type": "process" launches the executable directly, resolving it against
  //     VS Code's own PATH - not a shell's. macOS registers dotnet in
  //     /etc/paths.d/dotnet, but that file is only read by path_helper during
  //     *login shell* startup, so a VS Code launched from the Dock or Finder never
  //     sees it and the task fails with "Path to shell executable dotnet does not
  //     exist". Switching to "type": "shell" does not fix this either: VS Code runs
  //     the shell non-interactively, which skips .zshrc as well.
  //
  //  2. The build spawns further dotnet processes - MGCB compiles the spritefont
  //     through dotnet local tools. Those look dotnet up on PATH, and a content
  //     build that cannot find it fails *without failing the build*, leaving the
  //     game to die at startup on ContentLoadException: Content/Fonts/UiFont.xnb.
  "tasks": [
    {
      "label": "build",
      "command": "/usr/local/share/dotnet/dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/GoL.slnx"],
      "options": {
        "env": {
          "PATH": "/usr/local/share/dotnet:${env:HOME}/.dotnet/tools:${env:PATH}",
          "DYLD_FALLBACK_LIBRARY_PATH": "/opt/homebrew/lib:/usr/local/lib"
        }
      },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "command": "/usr/local/share/dotnet/dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/GoL.slnx"],
      "options": {
        "env": {
          "PATH": "/usr/local/share/dotnet:${env:HOME}/.dotnet/tools:${env:PATH}"
        }
      },
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "run",
      "command": "/usr/local/share/dotnet/dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/src/GoL.App"],
      "options": {
        "env": {
          "PATH": "/usr/local/share/dotnet:${env:HOME}/.dotnet/tools:${env:PATH}",
          "DYLD_FALLBACK_LIBRARY_PATH": "/opt/homebrew/lib:/usr/local/lib"
        }
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
